# Copy to .env.local for local dev (vercel dev reads it automatically).
# On Vercel: Project Settings -> Environment Variables.
#
# Note: the VPA is not a secret. It is inside every upi:// link and QR you
# hand out. These vars keep it out of git and configurable per deployment.

# Required
UPI_VPA=yourname@okaxis
UPI_PAYEE_NAME=Your Business Name

# Optional
UPI_CURRENCY=INR
UPI_DEFAULT_AMOUNT=
UPI_LOCK_AMOUNT=false
UPI_NOTE=
UPI_MERCHANT_CODE=

# Payment verification
# Each payment gets its own amount, UPI_DEFAULT_AMOUNT.01 to .99 (e.g. 10.37),
# held for one hour, so you can match bank credits to payments by amount.
# UPI_DEFAULT_AMOUNT must be whole rupees when this is on.
UPI_UNIQUE_AMOUNT=false
# Long random string. Unlocks /admin.html, where you mark payments verified.
ADMIN_TOKEN=
# On Vercel, add "Upstash for Redis" (Storage tab) and these are set for you.
# Locally, leave them empty and payments are stored in data/store.json.
KV_REST_API_URL=
KV_REST_API_TOKEN=
